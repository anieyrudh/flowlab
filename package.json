{
  "name": "flowlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit",
    "server": "python3 -m uvicorn server.app:app --reload --host 127.0.0.1 --port 8787",
    "smoke:openfoam": "python3 -m server.flowlab.smoke",
    "smoke:su2": "python3 -m server.flowlab.smoke --solver su2",
    "smoke:mujoco": "python3 -m server.flowlab.smoke --solver mujoco",
    "smoke:code-saturne": "python3 -m server.flowlab.smoke --solver code-saturne",
    "desktop:build": "bash scripts/build_macos_app.sh",
    "desktop:qa": "bash scripts/qa_macos_app.sh release/FlowLab.app internal",
    "desktop:qa:external": "bash scripts/qa_macos_app.sh release/FlowLab.app external"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "immer": "^11.0.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.184.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "zod": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "jsdom": "^27.3.0",
    "vitest": "^4.0.15"
  }
}
