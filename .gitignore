out/

# Root and generated solver logs
*.log

# Native build output
*.o
*.d
*.so
*.dylib
benchmarks/tools/**/Make/linux*/

# Raw scientific execution evidence is retained locally, not in normal Git.
# The exact compact files intentionally tracked from these trees are listed in
# benchmarks/tracked-evidence.txt and are force-added only after hash review.
benchmarks/cases/**/runs/
benchmarks/cases/**/campaigns/

# Archives and raw external datasets belong in the evidence archive, not Git.
*.zip
*.tar
*.tar.gz
*.tgz
