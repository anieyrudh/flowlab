    "algorithm": "polyMesh-cell-vertex-signature-v1",
    "generatedMeshAndPolyMeshMustMatchOneToOne": true,
    "orderingAssumptionAllowed": false,
    "uniqueExplicitEdgeOwnershipRequired": true,
    "connectorCellsOwnedByEdges": false,
