  "gates": {
    "determinism": {
      "independentBuildCount": 2,
      "allGeneratedFileHashesMustMatch": true
    },
    "meshPerLevel": {
      "spatialDimension": 3,
      "minimumCellVolumeM3ExclusiveLowerBound": 0.0,
      "checkMeshExitCode": 0,
      "meshOk": true,
      "solutionDirections": 3,
      "geometricDirections": 3,
      "requiredPatches": {
        "inlet": "patch",
        "outlet": "patch",
