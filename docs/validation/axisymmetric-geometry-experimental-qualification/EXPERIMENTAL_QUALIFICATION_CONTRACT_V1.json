    "qualificationClass": "experimental-software-geometry-only",
    "included": [
      "constant straight circular pipes remain governed by their existing stricter campaign",
      "generation-only Venturi",
      "generation-only contraction",
      "generation-only expansion",
      "generation-only nozzle",
      "one five-edge straight-axis contraction-throat-expansion-recovery runtime path",
      "OpenFOAM generated-case, JobManager, result loading, and schematic-selection pipeline"
    ],
    "excluded": [
      "independent experimental validation",
      "benchmark or fixture promotion",
      "validated preset changes",
      "registry or campaign pointer changes",
      "product promotion",
      "release authorization",
      "turbulence",
      "transient flow",
      "multiphase flow",
      "compressible flow",
      "branches",
